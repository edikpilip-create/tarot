# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://tarotwarriorpath.com

# Only "production" is indexable. Use "development", "preview", or "staging" otherwise.
DEPLOYMENT_ENV=production

# Required for POST /api/telegram.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Reserved for the planned Cloudflare Turnstile integration.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
